<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="DexTorOS.Windows.x64"
      Name="DexTor OS"
      Manufacturer="DexTor OS"
      Version="$(ProductVersion)"
      ProductCode="*"
      Language="1033"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DexTor OS is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPHELPLINK" Value="https://dextoros.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://dextoros.com" />
    <Property Id="ARPPRODUCTICON" Value="DexTorIcon.exe" />
    <Property Id="ADDDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Icon Id="DexTorIcon.exe" SourceFile="$(sys.SOURCEFILEDIR)..\..\docs\favicon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DexTor OS" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DexTor OS" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="DexTor OS" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="LauncherComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="StartMenuFolderComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\DexTor.Launcher.exe" />
        <Exclude Files="!(bindpath.Payload)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <Component Id="LauncherComponent" Directory="INSTALLFOLDER" Guid="{751BE374-21C7-4817-AF7B-AEDDF8BF29A6}">
      <File Id="LauncherExe" Source="!(bindpath.Payload)\DexTor.Launcher.exe" KeyPath="yes" />
    </Component>

    <Component
        Id="DesktopShortcutComponent"
        Directory="DesktopFolder"
        Guid="{DAE4A8C8-9E36-45FA-A620-5366B40DC5E2}"
        Condition="ADDDESKTOPSHORTCUT = 1"
        Transitive="yes">
      <Shortcut
          Id="DesktopShortcut"
          Name="DexTor OS"
          Target="[INSTALLFOLDER]DexTor.Launcher.exe"
          Description="Create and run your private DexTor OS workspace"
          WorkingDirectory="INSTALLFOLDER"
          Icon="DexTorIcon.exe"
          Advertise="no" />
      <RegistryValue
          Root="HKCU"
          Key="Software\DexTor OS"
          Name="DesktopShortcut"
          Type="integer"
          Value="[ADDDESKTOPSHORTCUT]"
          KeyPath="yes" />
    </Component>

    <Component Id="StartMenuFolderComponent" Directory="ApplicationProgramsFolder" Guid="{D30EEAFB-A1B8-408D-86F6-C91927257927}">
      <Shortcut
          Id="StartMenuShortcut"
          Name="DexTor OS"
          Target="[INSTALLFOLDER]DexTor.Launcher.exe"
          Description="Create and run your private DexTor OS workspace"
          WorkingDirectory="INSTALLFOLDER"
          Icon="DexTorIcon.exe"
          Advertise="no" />
      <CreateFolder />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\DexTor OS"
          Name="StartMenuFolder"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
