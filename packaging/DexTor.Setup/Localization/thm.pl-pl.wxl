  <String Id="InstallHeader" Value="Witamy" />
  <String Id="InstallMessage" Value="Program zainstaluje DexTor Launcher - aplikację, która utworzy pendrive z DexTor OS i go uruchomi. Sam system nie jest instalowany na tym komputerze." />
  <String Id="InstallMessageOptions" Value="Instalator zainstaluje [WixBundleName] na tym komputerze. Kliknij przycisk Instaluj, aby kontynuować, Opcje, aby skonfigurować instalację, lub Anuluj, aby zakończyć." />
