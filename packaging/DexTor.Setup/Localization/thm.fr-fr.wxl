  <String Id="InstallMessage" Value="Le programme installe DexTor Launcher, l’application qui crée une clé USB avec DexTor OS et la démarre. DexTor OS lui-même n’est pas installé sur cet ordinateur." />
  <String Id="InstallMessageOptions" Value="Le programme d&apos;installation va installer [WixBundleName] sur cet ordinateur. Cliquez sur Installer pour continuer, sur Options pour définir les options d&apos;installation ou sur Annuler pour quitter." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Voulez-vous vraiment annuler l&apos;installation ?" />
