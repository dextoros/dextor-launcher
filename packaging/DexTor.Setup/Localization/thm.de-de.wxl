  <String Id="InstallHeader" Value="Willkommen" />
  <String Id="InstallMessage" Value="Installiert wird der DexTor Launcher - die App, die einen USB-Stick mit DexTor OS erstellt und startet. DexTor OS selbst wird nicht auf diesem Computer installiert." />
  <String Id="InstallMessageOptions" Value="[WixBundleName] wird auf diesem Computer installiert. Klicken Sie auf „Installieren“, um fortzufahren, auf „Optionen“, um Installationsoptionen festzulegen, oder auf „Abbrechen“, um das Setup zu beenden." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
