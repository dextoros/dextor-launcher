<?xml version="1.0" encoding="utf-8"?>
<!-- Original layout structure copyright .NET Foundation contributors, licensed under the Microsoft Reciprocal License.
     Redrawn for DexTor OS to the installer design (2026-10, UI kit of 2026-10-06): the wizard's window colour, wordmark and badge, a large
     title, the green "go" button and dark secondary buttons. Images come from Generate-ThemeAssets.ps1; positions
     that depend on text length are adjusted per language with <UI Control> in Localization\thm.*.wxl. -->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <!-- 0 body, 1 title, 2 badge caps, 3 button text, 4 strong line, 5 version, 6 disabled button text, 7 the green "all set" line -->
  <Font Id="0" Height="-14" Weight="400" Foreground="BCA6A6" Background="130F0E">Segoe UI</Font>
  <Font Id="1" Height="-32" Weight="600" Foreground="F5F2F2" Background="130F0E">Segoe UI Semibold</Font>
  <Font Id="2" Height="-12" Weight="600" Foreground="BCA6A6" Background="130F0E">Segoe UI Semibold</Font>
  <Font Id="3" Height="-14" Weight="600" Foreground="F5F2F2">Segoe UI Semibold</Font>
  <Font Id="4" Height="-14" Weight="600" Foreground="F5F2F2" Background="130F0E">Segoe UI Semibold</Font>
  <Font Id="5" Height="-14" Weight="500" Foreground="BCA6A6" Background="130F0E">Segoe UI</Font>
  <Font Id="6" Height="-14" Weight="600" Foreground="7A6A6A" Background="281B1D">Segoe UI Semibold</Font>
  <Font Id="7" Height="-14" Weight="500" Foreground="BEF07A" Background="1F2613">Segoe UI</Font>
  <!-- 606 x 422 makes a 620 x 460 window: thmutil sizes a popup as if it had a caption and borders. -->
  <Window Width="606" Height="422" HexStyle="900a0000" FontId="0" Caption="#(loc.Caption)" IconFile="app.ico">
    <!-- The window has no system caption, as in the design; this is its close button. -->
    <Button Name="WindowCloseButton" X="574" Y="0" Width="46" Height="32" TabStop="no" FontId="3">
      <Text></Text>
      <CloseWindowAction />
      <ButtonImage ImageFile="Assets/close-normal.png" />
      <ButtonHoverImage ImageFile="Assets/close-hover.png" />
      <ButtonSelectedImage ImageFile="Assets/close-hover.png" />
      <ButtonFocusImage ImageFile="Assets/close-normal.png" />
    </Button>

    <!-- The wordmark and the outlined BETA badge beside it, as in the design. -->
    <ImageControl X="33" Y="57" Width="150" Height="35" ImageFile="Assets/wordmark.png" />
    <ImageControl X="194" Y="62" Width="6" Height="24" ImageFile="Assets/badge-left.png" />
    <ImageControl X="200" Y="62" Width="39" Height="1" ImageFile="Assets/badge-line.png" />
    <ImageControl X="200" Y="85" Width="39" Height="1" ImageFile="Assets/badge-line.png" />
    <ImageControl X="239" Y="62" Width="6" Height="24" ImageFile="Assets/badge-right.png" />
    <Label Name="BetaBadgeText" X="198" Y="66" Width="43" Height="16" FontId="2" Center="yes" DisablePrefix="yes">#(loc.BadgeBeta)</Label>


    <Page Name="Loading">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
    </Page>

    <Page Name="Help">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="33" Y="178" Width="-33" Height="-80" FontId="0" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-30" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.HelpCloseButton)</Text>
        <CloseWindowAction />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
    </Page>

    <Page Name="Install">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">#(loc.InstallHeader)</Label>
      <Label X="33" Y="178" Width="-33" Height="64" FontId="0" DisablePrefix="yes">#(loc.InstallMessage)</Label>
      <Hypertext Name="EulaHyperlink" X="33" Y="250" Width="-33" Height="20" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
      <!-- The native checkbox keeps its accessible name; Windows draws checkbox captions
           black, so a separate label beside it carries the readable text. -->
      <Checkbox Name="AddDesktopShortcutCheckbox" X="33" Y="345" Width="16" Height="18" TabStop="yes" FontId="4">#(loc.DesktopShortcut)</Checkbox>
      <Label X="58" Y="344" Width="-33" Height="20" FontId="4" DisablePrefix="yes">#(loc.DesktopShortcut)</Label>
      <Checkbox Name="EulaAcceptCheckbox" X="33" Y="372" Width="-33" Height="18" TabStop="yes" FontId="4" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
      <Label Name="InstallVersion" X="33" Y="399" Width="210" Height="20" FontId="5" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Button Name="InstallUpdateButton" X="33" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.UpdateButton)</Text>
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="InstallCancelButton" X="-242" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.InstallCancelButton)</Text>
        <CloseWindowAction />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="InstallButton" X="-30" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" ElevationShieldCondition="WixBundleAuthoredScope = 1 AND NOT WixBundleElevated" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.InstallInstallButton)</Text>
        <ButtonImage ImageFile="Assets/primary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/primary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/primary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/primary-focus.png" />
      </Button>
    </Page>

    <Page Name="Options">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
      <Label X="33" Y="178" Width="-33" Height="20" FontId="0" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
      <Editbox Name="InstallFolder" X="33" Y="206" Width="-160" Height="24" TabStop="yes" FontId="4" FileSystemAutoComplete="yes" />
      <Button Name="BrowseButton" X="-32" Y="200" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.OptionsBrowseButton)</Text>
        <BrowseDirectoryAction VariableName="InstallFolder" />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="OptionsCancelButton" X="-242" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.OptionsCancelButton)</Text>
        <ChangePageAction Page="Install" Cancel="yes" />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="OptionsOkButton" X="-30" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.OptionsOkButton)</Text>
        <ChangePageAction Page="Install" />
        <ButtonImage ImageFile="Assets/primary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/primary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/primary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/primary-focus.png" />
      </Button>
    </Page>

    <Page Name="Progress">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="33" Y="178" Width="-33" Height="24" FontId="0" DisablePrefix="yes">#(loc.ProgressMessage)</Label>
      <!-- The current action on the left, the percentage on the right (SS_RIGHT), a thin bar below. -->
      <Label Name="OverallProgressPackageText" X="33" Y="228" Width="-110" Height="20" FontId="4" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Label Name="OverallProgressText" X="-32" Y="228" Width="70" Height="20" FontId="4" HexStyle="2" DisablePrefix="yes" />
      <Progressbar Name="OverallCalculatedProgressbar" X="33" Y="254" Width="-30" Height="8">
        <ProgressbarImage ImageFile="Assets/progress.png" />
      </Progressbar>
      <Label X="33" Y="399" Width="210" Height="20" FontId="5" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Button Name="ProgressCancelButton" X="-242" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.ProgressCancelButton)</Text>
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <!-- The design's dimmed "Installing..." in place of the primary button. -->
      <ImageControl X="-30" Y="-30" Width="200" Height="40" ImageFile="Assets/disabled.png" />
      <Label X="-32" Y="-40" Width="196" Height="20" FontId="6" Center="yes" DisablePrefix="yes">#(loc.ProgressWorking)</Label>
    </Page>

    <Page Name="Modify">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Label X="33" Y="399" Width="210" Height="20" FontId="5" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Button Name="ModifyUpdateButton" X="33" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.UpdateButton)</Text>
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="RepairButton" X="-294" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HideWhenDisabled="yes" ElevationShieldCondition="WixBundleAuthoredScope = 1 AND NOT WixBundleElevated" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.ModifyRepairButton)</Text>
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="UninstallButton" X="-162" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" ElevationShieldCondition="WixBundleAuthoredScope = 1 AND NOT WixBundleElevated" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.ModifyUninstallButton)</Text>
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="ModifyCancelButton" X="-30" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.ModifyCancelButton)</Text>
        <CloseWindowAction />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
    </Page>

    <Page Name="Success">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.SuccessInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Label X="33" Y="178" Width="-33" Height="40" FontId="0" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
      <!-- Not "WixBundleAction = 5": testers saw an empty page under the heading. Anything but an uninstall shows the texts. -->
      <Label X="33" Y="178" Width="-33" Height="40" FontId="0" DisablePrefix="yes" VisibleCondition="NOT WixStdBARestartRequired AND WixBundleAction &lt;&gt; 3 AND AddDesktopShortcutCheckbox">#(loc.SuccessInstalledShortcutText)</Label>
      <Label X="33" Y="178" Width="-33" Height="40" FontId="0" DisablePrefix="yes" VisibleCondition="NOT WixStdBARestartRequired AND WixBundleAction &lt;&gt; 3 AND NOT AddDesktopShortcutCheckbox">#(loc.SuccessInstalledText)</Label>
      <ImageControl X="33" Y="226" Width="556" Height="52" ImageFile="Assets/success-block.png" VisibleCondition="NOT WixStdBARestartRequired AND WixBundleAction &lt;&gt; 3" />
      <Label X="89" Y="242" Width="490" Height="20" FontId="7" DisablePrefix="yes" VisibleCondition="NOT WixStdBARestartRequired AND WixBundleAction &lt;&gt; 3">#(loc.SuccessReadyText)</Label>
      <Label X="33" Y="399" Width="210" Height="20" FontId="5" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Button Name="SuccessCloseButton" X="-242" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.SuccessCloseButton)</Text>
        <CloseWindowAction />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="LaunchButton" X="-30" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" HideWhenDisabled="yes" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.SuccessLaunchButton)</Text>
        <ButtonImage ImageFile="Assets/primary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/primary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/primary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/primary-focus.png" />
      </Button>
      <Button Name="SuccessRestartButton" X="-30" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" HideWhenDisabled="yes" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.SuccessRestartButton)</Text>
        <ButtonImage ImageFile="Assets/primary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/primary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/primary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/primary-focus.png" />
      </Button>
    </Page>

    <Page Name="Failure">
      <Label X="33" Y="118" Width="-33" Height="44" FontId="1" DisablePrefix="yes">
        <Text>#(loc.FailureHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.FailureInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.FailureRepairHeader)</Text>
      </Label>
      <Hypertext Name="FailureLogFileLink" X="33" Y="178" Width="-33" Height="44" FontId="0" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="33" Y="226" Width="-33" Height="80" FontId="0" TabStop="yes" HideWhenDisabled="yes" />
      <Label X="33" Y="312" Width="-33" Height="40" FontId="0" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Label X="33" Y="399" Width="210" Height="20" FontId="5" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Button Name="FailureCloseButton" X="-242" Y="-30" Width="120" Height="40" TabStop="yes" FontId="3" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.FailureCloseButton)</Text>
        <CloseWindowAction />
        <ButtonImage ImageFile="Assets/secondary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/secondary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/secondary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/secondary-focus.png" />
      </Button>
      <Button Name="FailureRestartButton" X="-30" Y="-30" Width="200" Height="40" TabStop="yes" FontId="3" HideWhenDisabled="yes" HoverFontId="3" SelectedFontId="3">
        <Text>#(loc.FailureRestartButton)</Text>
        <ButtonImage ImageFile="Assets/primary-normal.png" />
        <ButtonHoverImage ImageFile="Assets/primary-hover.png" />
        <ButtonSelectedImage ImageFile="Assets/primary-pressed.png" />
        <ButtonFocusImage ImageFile="Assets/primary-focus.png" />
      </Button>
    </Page>
  </Window>
</Theme>
