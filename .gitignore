# Downloaded/runtime payloads and VM images
/runtime/downloads/
/runtime/payload/
/runtime/qemu/
/packaging/runtime-payload/
qemu-w64-setup-*.exe
*.iso
*.img
*.qcow2
*.vhd
*.vhdx
*.7z
*.zip

# Never commit executable payloads. The QEMU runtime is staged at build time,
# not versioned; this is the safety net if it is ever staged in-tree.
*.exe
*.dll

# NuGet and local tool state
/.nuget/
/packages/
*.nupkg
*.snupkg

# IDE and user-local state
/.vs/
/.idea/
*.suo
*.user
