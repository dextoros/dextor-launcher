<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DexTor.Contracts</RootNamespace>
    <!-- PackagedApp calls the package APIs of kernel32 with character buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\DexTor.Domain\\DexTor.Domain.csproj" />
    <EmbeddedResource Include="..\..\runtime\qemu-manifest.json" LogicalName="DexTor.Contracts.qemu-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DexTor.Contracts.Tests" />
  </ItemGroup>

</Project>
