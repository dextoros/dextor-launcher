    <RootNamespace>DexTor.Provisioner</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\DexTor.Domain\\DexTor.Domain.csproj" />
    <ProjectReference Include="..\\DexTor.Contracts\\DexTor.Contracts.csproj" />
